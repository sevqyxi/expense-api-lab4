# Скопіюйте цей файл у .env і за потреби змініть значення
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expenses
POSTGRES_HOST=localhost
# порт PostgreSQL на комп'ютері (5433, якщо 5432 зайнятий)
POSTGRES_PORT=5433

# секрет для підпису JWT — для реального середовища згенеруйте свій:
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-local-dev-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=60

# окрема БД для Pytest (створюється автоматично)
TEST_POSTGRES_DB=expenses_test
